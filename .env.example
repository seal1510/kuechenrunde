# Küchenrunde – Cloud-Konfiguration (Etappe A1/A2)
# Nur der öffentliche Publishable-Key gehört in den Browser.
# NIEMALS den service_role-Key hier eintragen oder in Cloudflare Pages setzen.
#
# Diese Datei nach .env kopieren und die Platzhalter ersetzen. .env ist
# gitignored und darf nie committet werden.
#
# Expliziter Modus: Ohne "cloud" bleibt die App vollständig lokal, auch wenn
# URL und Key gesetzt sind. Für den Cloud-Modus auf "cloud" setzen und beide
# Supabase-Werte eintragen.
VITE_DATA_MODE=local
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
